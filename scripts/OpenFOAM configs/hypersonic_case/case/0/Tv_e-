/*--------------------------------*- C++ -*----------------------------------*\
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Tv_e-;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Per-species vibrational temperature, required because downgradeToSingleTv
// is no (see Tv_N2 for the full source-verified explanation).
// Electrons have no vibrational mode either, but conventionally share the
// Tv pool rather than the TveAtom=0 convention (confirmed directly against
// hyStrath's own genericCase tutorial: 0.bak/Tv_e- uses the same $Tve value
// as the molecular species, not $TveAtom) - this is because electron
// translational/electronic energy is what the "eV"/"he" relaxation models
// in thermo2TModel (AppletonBray, BourdonVervisch) actually couple against,
// via this field, not a true vibrational quantum state.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 250.0;

boundaryField
{
    Inlet
    {
        type            inletOutlet;
        inletValue      uniform 250.0;
        value           uniform 250.0;
    }

    Atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 250.0;
        value           uniform 250.0;
    }

    Solid_Walls
    {
        type            fixedValue;
        value           uniform 1500.0;
    }

    Outlet
    {
        type            inletOutlet;
        inletValue      uniform 250.0;
        value           uniform 250.0;
    }
}

// ************************************************************************* //
