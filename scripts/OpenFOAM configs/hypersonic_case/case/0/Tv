/*--------------------------------*- C++ -*----------------------------------*\
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Tv;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Vibrational temperature. Initialized equal to Tt in freestream (thermal
// equilibrium). Tv will lag Tt strongly across the bow shock (non-equilibrium
// relaxation) - this lag is exactly what the 11-species / two-temperature
// model exists to capture. See docs/SETTINGS.md for the V-T relaxation
// discussion.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 250.0;

boundaryField
{
    farfield
    {
        type            inletOutlet;
        inletValue      uniform 250.0;
        value           uniform 250.0;
    }

    wall
    {
        // Isothermal wall, 1500 K, matching Tt (full vibrational
        // accommodation at the wall assumed - a common simplifying choice
        // when no better data on wall vibrational relaxation is available).
        type            fixedValue;
        value           uniform 1500.0;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 250.0;
        value           uniform 250.0;
    }
}

// ************************************************************************* //
