FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Tv_NO;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Per-species vibrational temperature, required because downgradeToSingleTv
// is no (see Tv_N2 for the full source-verified explanation).
// NO is diatomic -> real vibrational mode -> same freestream/wall values as
// the case's existing bulk Tv.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 250.0;

boundaryField
{
    Inlet
    {
        type            inletOutlet;
        inletValue      uniform 250.0;
        value           uniform 250.0;
    }

    Atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 250.0;
        value           uniform 250.0;
    }

    Solid_Walls
    {
        type            fixedValue;
        value           uniform 1500.0;
    }

    Outlet
    {
        type            inletOutlet;
        inletValue      uniform 250.0;
        value           uniform 250.0;
    }
}

