/*--------------------------------*- C++ -*----------------------------------*\
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Tt;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Translational temperature. Freestream Tt = Tv = 249 K (thermal equilibrium
// upstream of the shock). Post-shock Tt is estimated ~5000 K (normal-shock
// estimate for M=10 at this freestream T) - see docs/SETTINGS.md.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 249.0;

boundaryField
{
    farfield
    {
        type            inletOutlet;
        inletValue      uniform 249.0;
        value           uniform 249.0;
    }

    wall
    {
        // Isothermal wall, 1500 K, as requested. Simple fixedValue rather
        // than the rarefied nonEqSmoluchowskiJumpT slip-temperature BC used
        // in the repo's genericCase example - that BC targets near-
        // continuum-breakdown flows; this case is dense continuum
        // (130,000 ft, y+<1 wall-resolved), so plain fixedValue is the
        // physically appropriate and simpler choice.
        type            fixedValue;
        value           uniform 1500.0;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 249.0;
        value           uniform 249.0;
    }
}

// ************************************************************************* //
