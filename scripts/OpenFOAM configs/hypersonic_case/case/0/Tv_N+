FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Tv_N+;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Per-species vibrational temperature, required because downgradeToSingleTv
// is no (see Tv_N2 for the full explanation).
// N+ is monatomic -> no vibrational mode -> 0 K everywhere, matching
// hyStrath's own genericCase convention (TveAtom=0). See Tv_N for the full
// rationale. Freestream mass fraction is 0 (see 0/N+); N+ only forms once
// temperatures are high enough for associative/electron-impact ionization.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 0.0;

boundaryField
{
    Inlet
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    Atmosphere
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    Solid_Walls
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    Outlet
    {
        type            fixedValue;
        value           uniform 0.0;
    }
}

