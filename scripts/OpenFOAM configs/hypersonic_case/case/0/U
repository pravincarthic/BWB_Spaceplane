FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Freestream: Mach 10 at 130,000 ft (39.6 km).
// u_inf = 3169.7 m/s is held fixed as the specified freestream speed.
// With the janaf cp(T) of constant/thermophysicalProperties the 250 K speed
// of sound is a_inf = 317.39 m/s (gamma = 1.4035), so the actual freestream
// Mach number is 9.987 rather than exactly 10.000 - a 0.13 percent
// difference that comes from using the calorically imperfect gamma instead
// of a fixed 1.4. Re/m = 8.056e5, Re_L = 3.87e7 over the 48.061 m body.
// NOTE: -5 deg AoA is already built into the mesh geometry (vehicle rotated
// relative to the domain axis), so the freestream vector below is kept purely
// axial. Do NOT decompose this into (Ux, Uy, Uz) components for AoA - that
// would double-apply the angle of attack.

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (3169.7 0 0);

boundaryField
{
    Inlet
    {
        type            freestream;
        freestreamValue uniform (3169.7 0 0);
        value           uniform (3169.7 0 0);
    }

    Atmosphere
    {
        type            freestream;
        freestreamValue uniform (3169.7 0 0);
        value           uniform (3169.7 0 0);
    }

    Solid_Walls
    {
        type            noSlip;
    }

    Outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (3169.7 0 0);
    }
}

