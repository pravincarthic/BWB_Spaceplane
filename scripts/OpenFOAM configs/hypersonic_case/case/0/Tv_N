FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Tv_N;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Per-species vibrational temperature, required because downgradeToSingleTv
// is no (see Tv_N2 for the full source-verified explanation).
//
// N is monatomic -> no vibrational degree of freedom exists to assign a
// temperature to. Set to 0 K everywhere (not the 250/1500 K used for the
// molecular species) - this is not a numerical placeholder, it mirrors
// hyStrath's own genericCase tutorial exactly (0.bak/Tv_N uses TveAtom=0,
// both at the inlet and at the wall). The field is carried purely because
// the solver's per-species field construction (MUST_READ "Tv_" + species)
// applies uniformly to every entry in the species list, atoms included;
// it never actually receives a physical vibrational-energy contribution
// for a monatomic species.
//
// Watch temperatureBounds (thermophysicalProperties: Tlow=200) in early
// solver output - if this field is included in any bound-checked energy
// path it would get clamped to 200 K, which is harmless for an inert field
// but worth noticing if it shows up in logs.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 0.0;

boundaryField
{
    Inlet
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    Atmosphere
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    Solid_Walls
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    Outlet
    {
        type            fixedValue;
        value           uniform 0.0;
    }
}

