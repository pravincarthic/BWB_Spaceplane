FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Freestream static pressure at 130,000 ft (user-supplied, same as ISA table).
//
// rhoCentralFoam solves for absolute static pressure in Pa - dimensions
// [1 -1 -2 0 0 0 0], NOT the kinematic p/rho used by the incompressible
// solvers. With T = 250 K and R = 287.102 J/kg/K (molWeight 28.95999) this
// gives rho_inf = 0.00406992 kg/m3.

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 292.12;

boundaryField
{
    Inlet
    {
        type            freestreamPressure;
        freestreamValue uniform 292.12;
        value           uniform 292.12;
    }

    Atmosphere
    {
        type            freestreamPressure;
        freestreamValue uniform 292.12;
        value           uniform 292.12;
    }

    Solid_Walls
    {
        type            zeroGradient;
    }

    Outlet
    {
        // Non-reflecting outflow. psi is registered as "thermo:psi" by
        // hePsiThermo in v2412. gamma is the advective wave speed exponent
        // only - 1.4 matches the janaf value at the 250 K far-field state
        // (1.4035), which is where this boundary sits.
        type            waveTransmissive;
        field           p;
        psi             thermo:psi;
        gamma           1.4;
        fieldInf        292.12;
        lInf            1.0;
        value           uniform 292.12;
    }
}

