FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      N2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Species mass fraction Y_N2. Field name matches the species name used
// verbatim in constant/chemDicts/hTCReactionsEarth93 and constant/thermoDEM
// (Park 1993, 11-species air). Freestream initialized to standard
// undissociated air (mass basis: N2=0.767, O2=0.233); all others zero and
// form behind the bow shock via the chemistry model.

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.767;

boundaryField
{
    Inlet
    {
        type            inletOutlet;
        inletValue      uniform 0.767;
        value           uniform 0.767;
    }

    Atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 0.767;
        value           uniform 0.767;
    }

    Solid_Walls
    {
        type            zeroGradient;
    }

    Outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.767;
        value           uniform 0.767;
    }
}

