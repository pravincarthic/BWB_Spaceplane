pseWallSpanwise
{
    $pseWallWindward;

    // Two spanwise rakes on the windward surface, at x = 20 m and x = 35 m.
    // These exist to measure the spanwise wavenumber beta of the disturbance.
    // The PSE configuration currently runs beta = 0 (a purely 2D second mode);
    // if these rakes show coherent phase variation across the span, that
    // assumption is wrong for this geometry and n_beta in
    // pse_solver/config/*.json needs to be opened up.
    probeLocations
    (
            (20.000   -12.000  -0.300  )
            (20.000   -8.000   -0.300  )
            (20.000   -4.000   -0.300  )
            (20.000   0.000    -0.300  )
            (20.000   4.000    -0.300  )
            (20.000   8.000    -0.300  )
            (20.000   12.000   -0.300  )
            (35.000   -12.000  -0.300  )
            (35.000   -8.000   -0.300  )
            (35.000   -4.000   -0.300  )
            (35.000   0.000    -0.300  )
            (35.000   4.000    -0.300  )
            (35.000   8.000    -0.300  )
            (35.000   12.000   -0.300  )
    );
}

// ===========================================================================
// 2. Boundary-layer rakes - mode shapes and the PSE baseflow profile
// ===========================================================================
// PSE needs two things from the CFD that a wall probe cannot give:
//   (a) the wall-normal mean profiles u(y), T(y), rho(y) it linearises about
//   (b) the wall-normal eigenfunction shape, to confirm the disturbance
//       really is the second mode and not a first-mode or entropy-layer
//       artefact
//
// These rakes provide both. They are sampled at 100 steps (4.5 us, fs =
// 222 kHz, fN = 111 kHz) rather than 10: that is still above the second-mode
// frequency at every station aft of x = 3 m, and 8 rakes x 241 points at the
// 10-step rate would be 1.6e8 samples, which is not a sensible amount of
// ASCII. Use the wall probes for spectra and these for structure.
//
// Each rake is 0.6 m long with 241 points (2.5 mm spacing), which covers the
// thickest expected boundary layer (201 mm at x = 47 m) plus the entropy
// layer above it, at roughly 12 points across the thinnest layer sampled
// (29 mm at x = 1 m). scripts/make_pse_probes.py replaces these straight
// z-lines with true wall-normal lines and clusters the points near the wall.

pseBLRakes
{
    type            sets;
    libs            (sampling);

    executeControl  timeStep;
    executeInterval 100;
    writeControl    timeStep;
    writeInterval   100;

    setFormat       raw;
    interpolationScheme cellPoint;

    fields          (p T U rho);

    sets
    (
        rake_x1p0
        {
            type        uniform;
            axis        distance;
            start       (1.000 0.000 -0.020);
            end         (1.000 0.000 -0.620);
            nPoints     241;
        }
        rake_x3p0
        {
            type        uniform;
            axis        distance;
            start       (3.000 0.000 -0.020);
            end         (3.000 0.000 -0.620);
            nPoints     241;
        }
        rake_x6p0
        {
            type        uniform;
            axis        distance;
            start       (6.000 0.000 -0.020);
            end         (6.000 0.000 -0.620);
            nPoints     241;
        }
        rake_x10p0
        {
            type        uniform;
            axis        distance;
            start       (10.000 0.000 -0.020);
            end         (10.000 0.000 -0.620);
            nPoints     241;
        }
        rake_x16p0
        {
            type        uniform;
            axis        distance;
            start       (16.000 0.000 -0.020);
            end         (16.000 0.000 -0.620);
            nPoints     241;
        }
        rake_x24p0
        {
            type        uniform;
            axis        distance;
            start       (24.000 0.000 -0.020);
            end         (24.000 0.000 -0.620);
            nPoints     241;
        }
        rake_x34p0
        {
            type        uniform;
            axis        distance;
            start       (34.000 0.000 -0.020);
            end         (34.000 0.000 -0.620);
            nPoints     241;
        }
        rake_x44p0
        {
            type        uniform;
            axis        distance;
            start       (44.000 0.000 -0.020);
            end         (44.000 0.000 -0.620);
            nPoints     241;
        }
    );
}

