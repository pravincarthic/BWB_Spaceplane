/*--------------------------------*- C++ -*----------------------------------*\
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     hy2Foam;

startFrom       startTime;
startTime       0;

stopAt          endTime;

// PLACEHOLDER: adjust to your required flow-through time / statistics window. A rough guess for a body length L: t_flowthrough ~ few*L/u_inf, u_inf = 3169.7 m/s. Set once you know your reference length.
endTime         0.02;

deltaT          1e-9;         // initial guess, overridden by adjustTimeStep

writeControl    adjustableRunTime;
writeInterval   1e-4;

purgeWrite      0;

writeFormat     binary;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   8;

runTimeModifiable true;

// Adaptive timestepping: essential given the mu(T) viscosity jump across
// the bow shock and the fine wall-resolved (y+<1) prism layer cells.
adjustTimeStep  yes;
maxCo           0.4;         // conservative given complex/extreme shock-shock
                              // interaction expected near leading edges
maxDeltaT       3e-7;

// REQUIRED - confirmed against genericCase/system/controlDict in the real
// repo: hy2Foam needs this custom finite-volume library loaded at runtime.
libs ("libstrathFiniteVolume.so");

functions
{
    forces
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;
        
        patches         (wall);
        rho             rhoInf;
        rhoInf          1.225;      // freestream density at 130,000 ft
        CofR            (25 0 0);   // center of rotation - adjust to vehicle CoG
        lRef            49.585;     // reference length (vehicle nose-to-tail)
        Aref            0.1;        // reference area - ADJUST to your vehicle planform
    }
    
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;
        
        patches         (wall);
        rho             rhoInf;
        rhoInf          1.225;
        CofR            (25 0 0);
        lRef            49.585;
        Aref            0.1;        // reference area - ADJUST
        
        magUInf         3169.7;     // freestream velocity magnitude
        liftDir         (0 0 1);    // lift direction (Z, normal to flow)
        dragDir         (1 0 0);    // drag direction (X, flow-aligned)
    }
    
    fieldMinMax
    {
        type            fieldMinMax;
        libs            ("libfieldFunctionObjects.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;
        fields          (p Tt Tv);
    }
}
