/*--------------------------------*- C++ -*----------------------------------*\
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     hy2Foam;

startFrom       startTime;
startTime       0;

stopAt          endTime;

// PLACEHOLDER: adjust to your required flow-through time / statistics window. A rough guess for a body length L: t_flowthrough ~ few*L/u_inf, u_inf = 3169.7 m/s. Set once you know your reference length.
endTime         0.03;

deltaT          1e-7;         // initial guess, overridden by adjustTimeStep

writeControl    adjustableRunTime;
writeInterval   1e-4;

purgeWrite      5;

writeFormat     binary;
writePrecision  10;
writeCompression on;

timeFormat      general;
timePrecision   8;

runTimeModifiable false;

// Adaptive timestepping: essential given the mu(T) viscosity jump across the bow shock and the fine wall-resolved (y+<1) prism layer cells.
adjustTimeStep  yes;
maxCo           0.4;         // conservative given complex/extreme shock-shock interaction expected near leading edges, change to 0.2 if crashes occur
maxDeltaT       3e-7;

// REQUIRED - confirmed against genericCase/system/controlDict in the real repo: hy2Foam needs this custom finite-volume library loaded at runtime.
libs ("libstrathFiniteVolume.so");

functions
{
    forces
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;
        
        patches         (wall);
        rho             rhoInf;
        rhoInf          0.00407069;      // freestream density at 130,000 ft
        CofR            (25.784 -2.256 0.769);   // center of rotation - adjust to vehicle CoM
        lRef            49.585;     // Reference length (vehicle nose-to-tail) in m
        Aref            0.1;        // Change to real value in m^2 as seen in a CAD viewer from the top view
    }
    
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;
        
        patches         (wall);
        rho             rhoInf;
        rhoInf          0.00407069;
        CofR            (25.784 -2.256 0.769);
        lRef            49.585;
        Aref            0.1;        // reference area - ADJUST
        
        magUInf         3169.7;     // freestream velocity magnitude
        liftDir         (0 0 1);    // lift direction (Z, normal to flow)
        dragDir         (1 0 0);    // drag direction (X, flow-aligned)
		pitchAxis       (0 1 0);    // Nose pitch by -5 deg
    }
    
    fieldMinMax
    {
        type            fieldMinMax;
        libs            ("libfieldFunctionObjects.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;
        fields          (p Tt Tv);
    }
	
	shockWave3D
    {
        type            surfaces;
        libs            ("libsampling.so"); 
        
        writeControl    timeStep;
        writeInterval   300;
        surfaceFormat   vtk;
        fields          ( U T p );

        interpolationScheme cellPoint;

        surfaces
        {
            bowShockIso
            {
                type        isoSurface;
                isoField    p;       
                isoValue    1000;   // Adjust to your freestream shock pressure jump
                interpolate true;
            }
        }
    }
}
