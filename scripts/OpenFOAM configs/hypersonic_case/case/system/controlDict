/*--------------------------------*- C++ -*----------------------------------*\
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     hy2Foam;

startFrom       startTime;
startTime       0;

stopAt          endTime;

// PLACEHOLDER: adjust to your required flow-through time / statistics window. A rough guess for a body length L: t_flowthrough ~ few*L/u_inf, u_inf = 3169.7 m/s. Set once you know your reference length.
endTime         0.03;

deltaT          1e-7;         // initial guess, overridden by adjustTimeStep

writeControl    adjustableRunTime;
writeInterval   1e-4;

purgeWrite      0;   // Needed for Paraview Visualisations

writeFormat     binary;
writePrecision  10;
writeCompression compressed;

timeFormat      general;
timePrecision   8;

runTimeModifiable false;

// Adaptive timestepping: essential given the mu(T) viscosity jump across the bow shock and the fine wall-resolved (y+<1) prism layer cells.
adjustTimeStep  yes;
maxCo           0.4;         // conservative given complex/extreme shock-shock interaction expected near leading edges, change to 0.2 if crashes occur
maxDeltaT       3e-7;

// REQUIRED - confirmed against genericCase/system/controlDict in the real repo: hy2Foam needs this custom finite-volume library loaded at runtime.
libs ("libstrathFiniteVolume.so");

functions
{
    forces
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;

        // FIXED: "wall" does not exist in this mesh. final_meshing.py tags the vehicle surface as physical group "Solid_Walls" (case-sensitive).
        patches         (Solid_Walls);
        rho             rhoInf;
        rhoInf          0.00407069;      // freestream density at 130,000 ft
        CofR            (25.717 0.000 3.022);   // center of rotation - adjust to vehicle CoM
        // FIXED: was 3% off the actual meshed body length. Measured directly from the STEP file's vehicle-solid bounding box (X-extent, as-meshed, rotated frame): 48060.7 mm = 48.061 m.
        lRef            48.061;
        Aref            912.1;        // Change to real value in m^2 as seen in a CAD viewer from the top view
    }
    
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;

        // FIXED: see forces block above.
        patches         (Solid_Walls);
        rho             rhoInf;
        rhoInf          0.00407069;
        CofR            (25.717 0.000 3.022);
        lRef            48.061;
        Aref            912.1;

        magUInf         3169.7;     // freestream velocity magnitude
        liftDir         (0 0 1);    // lift direction (Z, normal to flow)
        dragDir         (1 0 0);    // drag direction (X, flow-aligned)
        pitchAxis       (0 1 0);    // Nose pitch by -5 deg
    }

    fieldMinMax
    {
        type            fieldMinMax;
        libs            ("libfieldFunctionObjects.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;
        fields          (p Tt Tv);
    }

    shockWave3D
    {
        type            surfaces;
        libs            ("libsampling.so");

        // FIXED: was writeControl timeStep + writeInterval 300, which under adjustTimeStep=yes gives an unpredictable physical-time cadence and (at these deltaT bounds) lands near ~500 frames over the run, not
        // the requested 1000. adjustableRunTime + endTime/1000 guarantees ~1000 evenly time-spaced frames regardless of how the adaptive timestep behaves.
        writeControl    adjustableRunTime;
        writeInterval   3e-5;        // = endTime / 1000 = 0.03 / 1000
        surfaceFormat   vtk;
        fields          ( U Tt Tv p );

        interpolationScheme cellPoint;

        surfaces
        {
            bowShockIso
            {
                type        isoSurface;
                isoField    p;
                // FIXED: freestream p = 292.12 Pa; theoretical normal-shock jump at Mach 10 gives p2 ~ 34,032 Pa (p2/p1 ~ 116.5). The previous isoValue of 1000 Pa (~3.4x freestream) sits right at the very start of the compression and can pick up weak
                // off-body waves instead of the bow shock itself. 10,000 Pa (~34 x freestream, ~30% of the post-shock value) sits comfortably inside the shock layer. Adjust once you see the actual pressure field - this is still an estimate.
                isoValue    10000;
                interpolate true;
            }
        }
    }
}
