/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ============================================================================
// rhoCentralFoam - OpenFOAM v2412 - BWB spaceplane, M 9.99 at 130,000 ft
// ============================================================================
// Stock OpenCFD v2412. No hyStrath / hy2Foam libraries are loaded and none
// are required: every dictionary in this case uses core OpenFOAM models only.
// ============================================================================

application     rhoCentralFoam;

// latestTime lets a killed job be resubmitted with no edit; on a clean case
// the only time directory is 0, so it is equivalent to startFrom startTime.
startFrom       latestTime;
startTime       0;

stopAt          endTime;

// ---------------------------------------------------------------------------
// Time stepping: FIXED 45 ns, 675,000 steps
// ---------------------------------------------------------------------------
//   endTime = 675000 * 45e-9 = 0.030375 s
//
// A fixed step (adjustTimeStep no) is deliberate, not a fallback. The probe
// time series that feed the PSE second-Mack-mode analysis must be uniformly
// sampled: an adaptive step produces unevenly spaced samples, which cannot be
// FFT'd without resampling and which smears the narrow instability peak.
//
// Courant check for the 45 ns step (see docs/PARAMETERS.md for the working):
//   fastest wave speed  |u| + a = 3169.7 + 317.4 = 3487 m/s (freestream)
//   mesh minimum size   0.5 mm  (Mesh.MeshSizeMin in scripts/gmsh_config.json)
//   => Co_max = 3487 * 45e-9 / 0.5e-3 = 0.314
// which sits under the 0.37 CFL target with about 15 percent of headroom.
// Inverting the target: Co = 0.37 at 45 ns requires cells no smaller than
// 0.424 mm anywhere in the domain. The 0.5 mm floor in the mesh generator is
// what makes the fixed step safe - if the mesh is ever refined below 0.424 mm
// the step MUST come down with it or the explicit solver will diverge.
//
// maxCo below is not used to adapt anything while adjustTimeStep is no; it is
// kept as the documented design target, and the actual running value is
// monitored every 100 steps by the CourantNo/courantMonitor pair in
// system/monitorFunctions. Watch that log output on the first restart.
//
// Physical coverage: 0.030375 s at u_inf = 3169.7 m/s over the 48.061 m body
// is 2.0 flow-through times. That is enough to establish the shock layer and
// to give a 30.4 ms probe record (32.9 Hz frequency resolution, 1215 cycles
// of the 40 kHz lower band edge), but it is short for converged turbulence
// statistics - treat the fieldAverage output as a laminar mean baseflow for
// PSE, which is what it is for, not as an LES statistical average.
// ---------------------------------------------------------------------------
deltaT          4.5e-08;
endTime         0.030375;

adjustTimeStep  no;
maxCo           0.37;       // design target, monitored not enforced
maxDeltaT       4.5e-08;

// ---------------------------------------------------------------------------
// Volume field writes: 20 over the run
// ---------------------------------------------------------------------------
//   675000 / 33750 = 20 complete field dumps, at 1.51875 ms intervals.
// These are the full 31M-cell volume snapshots. Surface and probe output is
// far more frequent and is configured in the included function files.
// ---------------------------------------------------------------------------
writeControl    timeStep;
writeInterval   33750;

purgeWrite      0;          // keep all 20 - needed for the ParaView time series

writeFormat     binary;
writePrecision  10;

// Compression is OFF on purpose. With the collated file handler each write is
// already a single large sequential stream per field; gzip serialises that
// stream through one thread and, at 31M cells on 384 ranks, costs more wall
// time than the disk saving is worth.
writeCompression off;

timeFormat      general;
timePrecision   10;         // 45 ns steps need more digits than the default 6

runTimeModifiable false;    // no dictionary re-reads: this is a long batch run

// ---------------------------------------------------------------------------
// Collated output
// ---------------------------------------------------------------------------
// One file per field per write instead of 384 per field per write. On this
// case that is the difference between ~7,700 files per volume write and 20.
// It removes the metadata storm that otherwise dominates the write time on a
// parallel filesystem at this rank count, and it means reconstructPar is not
// needed at all - ParaView reads the collated case directly through the
// .foam reader, and postProcessing/ output is already collated by rank 0.
//
// Every parallel utility in the workflow (decomposePar, rhoCentralFoam,
// foamToVTK, postProcess) must agree on this setting, so it is set here in
// the case rather than per-command. scripts/run.sh additionally passes
// -fileHandler collated explicitly, which is harmless belt-and-braces.
//
// maxThreadFileBufferSize 0 makes the collated writes synchronous (rank 0
// writes and waits). Non-zero enables a background write thread, which is
// faster but needs MPI_THREAD_MULTIPLE from the MPI build; leave it at 0
// unless the site MPI is known to support that.
// ---------------------------------------------------------------------------
OptimisationSwitches
{
    fileHandler             collated;
    maxThreadFileBufferSize 0;
}

// ---------------------------------------------------------------------------
// Function objects
// ---------------------------------------------------------------------------
// Split across included files for readability. Order matters: derived fields
// (Ma, magGradRho, Co) are created in monitorFunctions and consumed by the
// sampling in surfacesShock, so monitorFunctions must be included first.
//
// The included files deliberately carry NO FoamFile header - everything
// inside functions{} is constructed as a function object, and a stray
// FoamFile sub-dictionary here would be treated as one and fail.
// ---------------------------------------------------------------------------
functions
{
    #include "monitorFunctions"
    #include "probesPSE"
    #include "surfacesShock"
}

// ************************************************************************* //
