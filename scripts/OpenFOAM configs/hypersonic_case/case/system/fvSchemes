/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ============================================================================
// rhoCentralFoam, OpenFOAM v2412: Kurganov (KNP) flux + vanLeer limiters, ILES
// ============================================================================
// fluxScheme is read by rhoCentralFoam itself (not by a div scheme). The two
// values stock rhoCentralFoam accepts are:
//
//   Kurganov  - Kurganov, Noelle & Petrova central-upwind (KNP). Uses
//               one-sided local wave speeds a+ and a-, so the numerical
//               dissipation collapses towards zero in smooth, low-Mach-
//               gradient regions and only switches on across discontinuities.
//   Tadmor    - Kurganov & Tadmor (KT). Symmetric wave speed, uniformly more
//               dissipative.
//
// Kurganov is the required choice here for two reasons: it captures the bow
// shock without the KT scheme's extra smearing, and - critically for this
// case - its low dissipation in smooth regions is what lets the second Mack
// mode wavepacket survive advection down the 48 m boundary layer to the
// downstream PSE probes instead of being numerically damped out.
//
// Every reconstruction is vanLeer-limited. Those limiters are the ONLY
// subgrid dissipation in the run: constant/turbulenceProperties selects
// laminar/Stokes, so no explicit SGS model contributes. That is the ILES
// closure.
// ============================================================================

fluxScheme      Kurganov;

ddtSchemes
{
    // First-order Euler. rhoCentralFoam is explicit and this case runs at a
    // fixed 45 ns step with Co ~ 0.31, so the temporal truncation error is
    // small; Euler also keeps the scheme monotone across the bow shock,
    // where a backward/CrankNicolson step would ring.
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

    // The only explicit divergence in rhoCentralFoam is the off-diagonal
    // part of the viscous stress tensor; convection is handled entirely by
    // the KNP flux above, not by a div scheme.
    div(tauMC)      Gauss linear;
}

laplacianSchemes
{
    // Diffusion terms (viscous momentum, thermal conduction). "corrected"
    // is the non-orthogonality-correcting surface normal gradient, needed
    // on this hybrid prism/tet mesh.
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;

    // Face reconstruction of the primitive variables for the KNP flux.
    // vanLeer is a smooth, symmetric, second-order TVD limiter - monotone
    // through the shock, and far less dissipative in smooth flow than
    // minmod, which matters for the instability wave. vanLeerV is the
    // vector form: it applies a single limiter value to all three velocity
    // components based on the most-limited direction, which keeps the
    // reconstructed velocity vector from being rotated by the limiter.
    reconstruct(rho) vanLeer;
    reconstruct(U)   vanLeerV;
    reconstruct(T)   vanLeer;
}

snGradSchemes
{
    default         corrected;
}

// ************************************************************************* //
