FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// OpenCFD OpenFOAM v2412 with the ported hypersonicfoam hyStrath solvers.
// ILES: molecular transport and the Kurganov flux limiters provide dissipation.
// No explicit eddy viscosity or subgrid model is selected.
// Stokes is registered by the fork's turbulentFluidThermoModels.C and uses
// the base OpenFOAM laminar selector. In v2412 its selection key is "model".

simulationType  laminar;

laminar
{
    model           Stokes;
    printCoeffs     off;
}

