/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ILES on stock OpenFOAM v2412.
//
// simulationType laminar + model Stokes selects Foam::laminarModels::Stokes,
// the plain Newtonian stress model: the deviatoric stress is built purely
// from the molecular mu(T) supplied by constant/thermophysicalProperties.
// No eddy viscosity, no subgrid-scale model, no wall function, no nut or
// alphat field is created or read.
//
// The only other dissipation in the run is numerical, from the vanLeer
// limiters on the Kurganov (KNP) reconstruction in system/fvSchemes. That
// limiter dissipation IS the implicit subgrid model - which is exactly what
// makes this an ILES rather than an under-resolved DNS or a modelled LES.
// Do not add a Smagorinsky/WALE block here: it would double-count the
// subgrid dissipation on top of the limiters.
//
// This also keeps the baseflow that the PSE solver consumes free of any
// modelled eddy viscosity, which a linear-stability analysis of the second
// Mack mode requires - the mean flow must be the laminar one.

simulationType  laminar;

laminar
{
    model           Stokes;
    printCoeffs     off;
}

// ************************************************************************* //
